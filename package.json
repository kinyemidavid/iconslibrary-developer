{
  "name": "@iconslibrary/cli",
  "version": "0.1.0",
  "description": "Install versioned IconsLibrary drawings, Kits and Motion.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/kinyemidavid/iconslibrary-developer.git" },
  "bin": { "iconslibrary": "dist/cli.js" },
  "files": ["dist/cli.js", "README.md", "THIRD_PARTY_NOTICES.txt"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "devDependencies": { "esbuild": "0.25.12", "fflate": "0.8.2" }
}
